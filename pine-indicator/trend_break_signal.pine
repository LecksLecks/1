//@version=6
indicator("Trend Break Signal — Crypto MTF (Structure + Candles + Divergence)", shorttitle="TBS", overlay=true, max_labels_count=500, max_lines_count=500)

// =====================================================================
// INPUTS
// =====================================================================
grpStruct = "Market Structure"
pivotLeft        = input.int(5, "Pivot Left Bars", group=grpStruct, minval=1)
pivotRight       = input.int(5, "Pivot Right Bars", group=grpStruct, minval=1)
atrLen           = input.int(14, "ATR Length (noise filter)", group=grpStruct)
minSwingATRMult  = input.float(0.5, "Min Swing Size (x ATR)", group=grpStruct, minval=0)
holdBars         = input.int(0, "Break Confirmation Hold Bars (0 = off)", group=grpStruct, minval=0,
     tooltip="If > 0, delays a CHoCH signal by N bars and cancels it if price closes back through the broken level before N bars pass. Reduces false breakouts at the cost of later signals. Never repaints an already-plotted signal.")

grpCandle = "Candlestick Patterns"
pinWickMult        = input.float(2.0, "Pin Bar Wick/Body Multiplier", group=grpCandle, minval=1.0)
engulfMinBodyRatio = input.float(1.0, "Engulfing Min Body Ratio", group=grpCandle, minval=0.1)
starBodyMaxRatio   = input.float(0.3, "Star Middle Candle Max Body/Range", group=grpCandle, minval=0.05, maxval=1.0)
volSpikeMult       = input.float(1.5, "Volume Spike Multiplier (x SMA20)", group=grpCandle, minval=1.0)
levelProxATRmult   = input.float(0.5, "Level Proximity (x ATR)", group=grpCandle, minval=0.1)
priorMoveLookback  = input.int(3, "Prior Move Context Lookback (bars)", group=grpCandle, minval=1)

grpDiv = "Divergence"
rsiLen             = input.int(14, "RSI Length", group=grpDiv)
macdFast           = input.int(12, "MACD Fast", group=grpDiv)
macdSlow           = input.int(26, "MACD Slow", group=grpDiv)
macdSignalLen      = input.int(9, "MACD Signal", group=grpDiv)
divMinBars         = input.int(5, "Divergence Min Bars Between Pivots", group=grpDiv, minval=1)
divMaxBars         = input.int(60, "Divergence Max Bars Between Pivots", group=grpDiv, minval=2)
divMinPriceChgPct  = input.float(0.1, "Divergence Min Price Change %", group=grpDiv, minval=0.0)
rsiOversoldZone    = input.float(40.0, "RSI Zone Bonus: Bullish below", group=grpDiv)
rsiOverboughtZone  = input.float(60.0, "RSI Zone Bonus: Bearish above", group=grpDiv)

grpHTF = "Higher Timeframe Context (heuristic bias, not full structure)"
useHTF   = input.bool(true, "Use HTF Context", group=grpHTF)
htf1     = input.timeframe("15", "HTF #1", group=grpHTF)
htf2     = input.timeframe("60", "HTF #2", group=grpHTF)
htfEmaFastLen = input.int(20, "HTF EMA Fast", group=grpHTF)
htfEmaSlowLen = input.int(50, "HTF EMA Slow", group=grpHTF)

grpScore = "Scoring / Mode"
modeInput = input.string("Balanced", "Signal Mode", options=["Strict", "Balanced", "Aggressive"], group=grpScore)
wCandle  = input.float(1.0, "Candlestick Weight", group=grpScore)
wDiverg  = input.float(1.5, "Divergence Weight", group=grpScore)
wHTF     = input.float(1.0, "HTF Alignment Weight", group=grpScore)

grpDisp = "Display"
showMarkers   = input.bool(true, "Show Signal Markers", group=grpDisp)
showStructure = input.bool(true, "Show Structure Lines", group=grpDisp)
showScorePanel = input.bool(true, "Show Score Table", group=grpDisp)

// =====================================================================
// SHARED SERIES
// =====================================================================
atrVal   = ta.atr(atrLen)
volSma20 = ta.sma(volume, 20)
rsiVal   = ta.rsi(close, rsiLen)
[macdLine, macdSignalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSignalLen)

// mode thresholds — initial values, calibrate via backtest before production use
thresholdUp   = modeInput == "Strict" ? 5.0 : modeInput == "Balanced" ? 3.5 : 2.0
thresholdDown = thresholdUp
requireHTFalign = modeInput == "Strict"

// =====================================================================
// STRUCTURE MODULE
// (function-local `var` state is isolated per textual call site in Pine,
//  so calling this once here gives one independent persistent instance)
// =====================================================================
f_structure(srcHigh, srcLow, srcClose, atrValue, L, R, minATRmult, hold) =>
    var float lastSwingHigh = na
    var float lastSwingLow  = na
    var string lastHighType = na
    var string lastLowType  = na
    var string state        = "range"
    var float pendingLevel  = na
    var string pendingDir   = na
    var int pendingBar      = na

    ph = ta.pivothigh(srcHigh, L, R)
    pl = ta.pivotlow(srcLow, L, R)

    bosUp   = false
    bosDown = false

    if not na(ph)
        noiseOkH = na(lastSwingHigh) or math.abs(ph - lastSwingHigh) >= atrValue * minATRmult
        if noiseOkH
            if not na(lastSwingHigh)
                lastHighType := ph > lastSwingHigh ? "HH" : "LH"
                if state == "up" and lastHighType == "HH"
                    bosUp := true
            lastSwingHigh := ph

    if not na(pl)
        noiseOkL = na(lastSwingLow) or math.abs(pl - lastSwingLow) >= atrValue * minATRmult
        if noiseOkL
            if not na(lastSwingLow)
                lastLowType := pl < lastSwingLow ? "LL" : "HL"
                if state == "down" and lastLowType == "LL"
                    bosDown := true
            lastSwingLow := pl

    if lastHighType == "HH" and lastLowType == "HL"
        state := "up"
    else if lastHighType == "LH" and lastLowType == "LL"
        state := "down"

    chochUpRaw   = state == "down" and not na(lastSwingHigh) and ta.crossover(srcClose, lastSwingHigh)
    chochDownRaw = state == "up"   and not na(lastSwingLow)  and ta.crossunder(srcClose, lastSwingLow)

    chochUp   = false
    chochDown = false

    if hold <= 0
        chochUp   := chochUpRaw
        chochDown := chochDownRaw
        if chochUp
            state := "up"
        if chochDown
            state := "down"
    else
        if chochUpRaw and na(pendingDir)
            pendingDir := "up"
            pendingLevel := lastSwingHigh
            pendingBar := bar_index
        if chochDownRaw and na(pendingDir)
            pendingDir := "down"
            pendingLevel := lastSwingLow
            pendingBar := bar_index
        if not na(pendingDir)
            barsSince = bar_index - pendingBar
            failed = pendingDir == "up" ? srcClose < pendingLevel : srcClose > pendingLevel
            if failed
                pendingDir := na
            else if barsSince >= hold
                chochUp   := pendingDir == "up"
                chochDown := pendingDir == "down"
                if chochUp
                    state := "up"
                if chochDown
                    state := "down"
                pendingDir := na

    [state, chochUp, chochDown, bosUp, bosDown, lastSwingHigh, lastSwingLow]

[structState, chochUp, chochDown, bosUp, bosDown, lastSwingHigh, lastSwingLow] =
     f_structure(high, low, close, atrVal, pivotLeft, pivotRight, minSwingATRMult, holdBars)

// =====================================================================
// CANDLESTICK MODULE
// =====================================================================
bodyC   = math.abs(close - open)
rangeC  = high - low
upWick  = high - math.max(close, open)
loWick  = math.min(close, open) - low

priorMoveDown = close < close[priorMoveLookback]
priorMoveUp   = close > close[priorMoveLookback]

bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and bodyC >= bodyC[1] * engulfMinBodyRatio
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and bodyC >= bodyC[1] * engulfMinBodyRatio

pinBullShape = loWick >= bodyC * pinWickMult and upWick <= bodyC and close > open
pinBearShape = upWick >= bodyC * pinWickMult and loWick <= bodyC and close < open

hammer     = pinBullShape and priorMoveDown
hangingMan = pinBearShape and priorMoveUp
pinBull    = pinBullShape and not hammer
pinBear    = pinBearShape and not hangingMan

smallBody1 = math.abs(close[1] - open[1]) <= (high[1] - low[1]) * starBodyMaxRatio
morningStar = close[2] < open[2] and smallBody1 and close > open and close > (open[2] + close[2]) / 2
eveningStar = close[2] > open[2] and smallBody1 and close < open and close < (open[2] + close[2]) / 2

volSpike = volume >= volSma20 * volSpikeMult

nearLevel(lvl) =>
    not na(lvl) and math.abs(close - lvl) <= atrVal * levelProxATRmult

candleBullFire = bullEngulf or pinBull or hammer or morningStar
candleBearFire = bearEngulf or pinBear or hangingMan or eveningStar

candleBullScore = 0.0
candleBearScore = 0.0

if candleBullFire
    s = 1.0
    if hammer or morningStar
        s += 1.0
    if nearLevel(lastSwingLow)
        s += 1.0
    if volSpike
        s += 1.0
    candleBullScore := s

if candleBearFire
    s2 = 1.0
    if hangingMan or eveningStar
        s2 += 1.0
    if nearLevel(lastSwingHigh)
        s2 += 1.0
    if volSpike
        s2 += 1.0
    candleBearScore := s2

// =====================================================================
// DIVERGENCE MODULE
// price-pivot-anchored: oscillator value read at the confirmed price pivot bar
// =====================================================================
var float lastPLbar = na
var float lastPLprice = na
var float lastPLrsi = na
var float lastPLhist = na

var float lastPHbar = na
var float lastPHprice = na
var float lastPHrsi = na
var float lastPHhist = na

regBullDiv = false
hidBullDiv = false
regBearDiv = false
hidBearDiv = false
divBullScore = 0.0
divBearScore = 0.0

plDiv = ta.pivotlow(low, pivotLeft, pivotRight)
phDiv = ta.pivothigh(high, pivotLeft, pivotRight)

if not na(plDiv)
    curBar   = bar_index - pivotRight
    curPrice = plDiv
    curRsi   = rsiVal[pivotRight]
    curHist  = histLine[pivotRight]
    if not na(lastPLprice)
        gapBars = curBar - lastPLbar
        priceChgPct = math.abs(curPrice - lastPLprice) / lastPLprice * 100
        if gapBars >= divMinBars and gapBars <= divMaxBars and priceChgPct >= divMinPriceChgPct
            rsiAgrees  = curRsi > lastPLrsi
            histAgrees = curHist > lastPLhist
            if curPrice < lastPLprice and rsiAgrees
                regBullDiv := true
                sc = 1.0
                if rsiAgrees and histAgrees
                    sc += 1.0
                if priceChgPct >= divMinPriceChgPct * 3
                    sc += 1.0
                if curRsi < rsiOversoldZone
                    sc += 1.0
                if gapBars <= divMinBars * 1.2
                    sc -= 1.0
                divBullScore := sc
            if curPrice > lastPLprice and curRsi < lastPLrsi
                hidBullDiv := true
    lastPLbar := curBar
    lastPLprice := curPrice
    lastPLrsi := curRsi
    lastPLhist := curHist

if not na(phDiv)
    curBarH   = bar_index - pivotRight
    curPriceH = phDiv
    curRsiH   = rsiVal[pivotRight]
    curHistH  = histLine[pivotRight]
    if not na(lastPHprice)
        gapBarsH = curBarH - lastPHbar
        priceChgPctH = math.abs(curPriceH - lastPHprice) / lastPHprice * 100
        if gapBarsH >= divMinBars and gapBarsH <= divMaxBars and priceChgPctH >= divMinPriceChgPct
            rsiAgreesH  = curRsiH < lastPHrsi
            histAgreesH = curHistH < lastPHhist
            if curPriceH > lastPHprice and rsiAgreesH
                regBearDiv := true
                scH = 1.0
                if rsiAgreesH and histAgreesH
                    scH += 1.0
                if priceChgPctH >= divMinPriceChgPct * 3
                    scH += 1.0
                if curRsiH > rsiOverboughtZone
                    scH += 1.0
                if gapBarsH <= divMinBars * 1.2
                    scH -= 1.0
                divBearScore := scH
            if curPriceH < lastPHprice and curRsiH > lastPHrsi
                hidBearDiv := true
    lastPHbar := curBarH
    lastPHprice := curPriceH
    lastPHrsi := curRsiH
    lastPHhist := curHistH

// hidden divergence in the opposite direction of a CHoCH argues against the reversal — heuristic penalty
hiddenConflictUp   = chochUp and hidBearDiv
hiddenConflictDown = chochDown and hidBullDiv

// =====================================================================
// HTF CONTEXT (heuristic EMA-slope bias — see limitations)
// =====================================================================
f_htfBias(tf) =>
    // EMA must be computed INSIDE the security() expression, on the HTF's own bars.
    // Computing ta.ema() locally on a request.security-fetched raw `close` series
    // (a lower-timeframe-repeated staircase of HTF closes) does not reproduce a true
    // HTF EMA — it distorts the effective smoothing length/alpha. See Pine docs on
    // "avoid repainting" / recalculating indicators from request.security outputs.
    ef = request.security(syminfo.tickerid, tf, ta.ema(close, htfEmaFastLen), lookahead=barmerge.lookahead_off)
    es = request.security(syminfo.tickerid, tf, ta.ema(close, htfEmaSlowLen), lookahead=barmerge.lookahead_off)
    ef > es ? 1 : ef < es ? -1 : 0

htfBias1 = useHTF ? f_htfBias(htf1) : 0
htfBias2 = useHTF ? f_htfBias(htf2) : 0
htfBiasCombined = htfBias1 + htfBias2  // range -2..2

// =====================================================================
// SIGNAL SCORING MODULE
// =====================================================================
structureScoreUp   = chochUp   ? 2.0 : 0.0
structureScoreDown = chochDown ? 2.0 : 0.0

htfAlignUp   = htfBiasCombined > 0 ? wHTF : htfBiasCombined < 0 ? -wHTF : 0.0
htfAlignDown = htfBiasCombined < 0 ? wHTF : htfBiasCombined > 0 ? -wHTF : 0.0

scoreUp   = structureScoreUp   + candleBullScore * wCandle + divBullScore * wDiverg - (hiddenConflictUp   ? 1.0 : 0.0) + htfAlignUp
scoreDown = structureScoreDown + candleBearScore * wCandle + divBearScore * wDiverg - (hiddenConflictDown ? 1.0 : 0.0) + htfAlignDown

htfOkUp   = not requireHTFalign or htfBiasCombined >= 0
htfOkDown = not requireHTFalign or htfBiasCombined <= 0

signalUp   = chochUp   and scoreUp   >= thresholdUp   and htfOkUp
signalDown = chochDown and scoreDown >= thresholdDown and htfOkDown

signalCode = signalUp ? 1 : signalDown ? -1 : 0  // for dataset labeling: 1=trend_break_up, -1=trend_break_down, 0=neutral

// =====================================================================
// PLOTTING / MARKERS
// =====================================================================
plotshape(showMarkers and signalUp, title="Trend Break Up", style=shape.labelup, location=location.belowbar,
     color=color.new(color.green, 0), text="UP", textcolor=color.white, size=size.small)
plotshape(showMarkers and signalDown, title="Trend Break Down", style=shape.labeldown, location=location.abovebar,
     color=color.new(color.red, 0), text="DOWN", textcolor=color.white, size=size.small)

plotshape(showMarkers and chochUp and not signalUp, title="CHoCH Up (unconfirmed)", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.lime, 60), size=size.tiny)
plotshape(showMarkers and chochDown and not signalDown, title="CHoCH Down (unconfirmed)", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.orange, 60), size=size.tiny)

plot(showStructure ? lastSwingHigh : na, title="Last Swing High", color=color.new(color.red, 40), style=plot.style_circles)
plot(showStructure ? lastSwingLow  : na, title="Last Swing Low",  color=color.new(color.green, 40), style=plot.style_circles)

// hidden data-window plots for dataset labeling / NN feature export
plot(rsiVal, title="RSI (feature)", display=display.data_window)
plot(histLine, title="MACD Hist (feature)", display=display.data_window)
plot(candleBullScore, title="Candle Bull Score (feature)", display=display.data_window)
plot(candleBearScore, title="Candle Bear Score (feature)", display=display.data_window)
plot(divBullScore, title="Divergence Bull Score (feature)", display=display.data_window)
plot(divBearScore, title="Divergence Bear Score (feature)", display=display.data_window)
plot(htfBiasCombined, title="HTF Bias Combined (feature)", display=display.data_window)
plot(scoreUp, title="Score Up (feature)", display=display.data_window)
plot(scoreDown, title="Score Down (feature)", display=display.data_window)
plot(signalCode, title="Signal Code -1/0/1 (label candidate)", display=display.data_window)

// =====================================================================
// ALERTS
// =====================================================================
alertcondition(signalUp, title="Trend Break Up", message="{{ticker}} {{interval}}: TREND BREAK UP")
alertcondition(signalDown, title="Trend Break Down", message="{{ticker}} {{interval}}: TREND BREAK DOWN")

// =====================================================================
// SCORE PANEL
// =====================================================================
if showScorePanel and barstate.islast
    var table t = table.new(position.top_right, 2, 7, border_width=1, bgcolor=color.new(color.black, 70))
    table.cell(t, 0, 0, "Structure", text_color=color.white)
    table.cell(t, 1, 0, structState, text_color=color.white)
    table.cell(t, 0, 1, "Score Up", text_color=color.white)
    table.cell(t, 1, 1, str.tostring(scoreUp, "#.##"), text_color=color.lime)
    table.cell(t, 0, 2, "Score Down", text_color=color.white)
    table.cell(t, 1, 2, str.tostring(scoreDown, "#.##"), text_color=color.red)
    table.cell(t, 0, 3, "Threshold", text_color=color.white)
    table.cell(t, 1, 3, str.tostring(thresholdUp, "#.##"), text_color=color.white)
    table.cell(t, 0, 4, "HTF Bias", text_color=color.white)
    table.cell(t, 1, 4, str.tostring(htfBiasCombined), text_color=color.white)
    table.cell(t, 0, 5, "Mode", text_color=color.white)
    table.cell(t, 1, 5, modeInput, text_color=color.white)
    table.cell(t, 0, 6, "Last Signal", text_color=color.white)
    table.cell(t, 1, 6, signalUp ? "UP" : signalDown ? "DOWN" : "neutral", text_color=color.yellow)
